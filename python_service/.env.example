# Shadow Arrow AI Microservice — Environment Variables
# Copy this file to .env and fill in your real values before running locally.
# On Render, set these in the Environment tab of your service dashboard.

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the service listens on.
# Render injects $PORT automatically — leave this unset in production.
PORT=5001

# ─── Google Gemini ────────────────────────────────────────────────────────────
# Your Google AI Studio API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use.
GEMINI_MODEL=gemini-3.5-flash

# ─── Shadow Arrow Go Backend ──────────────────────────────────────────────────
# Full URL of the Go backend so this service can query orders, products, and tickets.
# Local dev:  http://localhost:8080
# Production: https://shadow-arrow-backend.onrender.com
BACKEND_URL=http://localhost:8080
